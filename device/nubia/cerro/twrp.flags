# mount point          fstype  device                                        device2              flags

# Logical partitions
/system_ext            erofs   system_ext                                                         flags=display="System_EXT";slotselect;logical
/system_ext            ext4    system_ext                                                         flags=display="System_EXT";slotselect;logical
/system_dlkm           erofs   system_dlkm                                                        flags=display="System_DLKM";slotselect;logical
/system_dlkm           ext4    system_dlkm                                                        flags=display="System_DLKM";slotselect;logical
/vendor_dlkm           erofs   vendor_dlkm                                                        flags=display="Vendor_DLKM";slotselect;logical
/vendor_dlkm           ext4    vendor_dlkm                                                        flags=display="Vendor_DLKM";slotselect;logical

# Data
/metadata              f2fs    /dev/block/bootdevice/by-name/metadata                             flags=display="Metadata";backup=1;formattable;fsflags="noatime,nosuid,nodev,discard wait";wrappedkey
#/data                  f2fs    /dev/block/bootdevice/by-name/userdata                             flags=display="Data";backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0

# Boot
/boot                  emmc    /dev/block/bootdevice/by-name/boot                                 flags=display="Boot";slotselect;backup=1;flashimg=1
/init_boot             emmc    /dev/block/bootdevice/by-name/init_boot                            flags=display="Init_Boot";slotselect;backup=1;flashimg=1
/vendor_boot           emmc    /dev/block/bootdevice/by-name/vendor_boot                          flags=display="Vendor_Boot";slotselect;backup=1;flashimg=1
/recovery              emmc    /dev/block/bootdevice/by-name/recovery                             flags=display="Recovery";slotselect;backup=1;flashimg=1

# AVB
/vbmeta                emmc    /dev/block/bootdevice/by-name/vbmeta                               flags=display="VBMeta";slotselect;backup=1;flashimg=1
/vbmeta_system         emmc    /dev/block/bootdevice/by-name/vbmeta_system                        flags=display="VBMeta_System";slotselect;backup=1;flashimg=1

# Persistent Firmware & Properties
/persist               ext4    /dev/block/bootdevice/by-name/persist                              flags=display="Persist";backup=0
/persist_image         emmc    /dev/block/bootdevice/by-name/persist                              flags=display="Persist_IMG";backup=1;flashimg=1
#/qmcs                  emmc    /dev/block/bootdevice/by-name/qmcs                                 flags=display="QMCS";backup=1;subpartitionof=/persist
#/spunvm                emmc    /dev/block/bootdevice/by-name/spunvm                               flags=display="SPUNVM";backup=1;subpartitionof=/persist
#/logdump               emmc    /dev/block/bootdevice/by-name/logdump                              flags=display="Logdump";backup=1

# Modem/Firmware partitions
/modem                 vfat    /dev/block/bootdevice/by-name/modem                                flags=display="Modem";slotselect;backup=1;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait"
/modem_image           emmc    /dev/block/bootdevice/by-name/modem                                flags=display="Modem_IMG";slotselect;backup=1;flashimg=1
/bluetooth             vfat    /dev/block/bootdevice/by-name/bluetooth                            flags=display="Bluetooth";slotselect;fsflags="ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait"
/bluetooth_image       emmc    /dev/block/bootdevice/by-name/bluetooth                            flags=display="Bluetooth_IMG";slotselect;backup=1;flashimg=1
/dsp                   ext4    /dev/block/bootdevice/by-name/dsp                                  flags=display="DSP";slotselect;fsflags="ro"
/dsp_image             emmc    /dev/block/bootdevice/by-name/dsp                                  flags=display="DSP_IMG";slotselect;backup=1;flashimg=1
/dtbo                  emmc    /dev/block/bootdevice/by-name/dtbo                                 flags=display="DTBO";slotselect;backup=1;flashimg=1

# EFS
/fsg                   emmc    /dev/block/bootdevice/by-name/fsg                                  flags=display="EFS (FSG)";backup=1
/fsc                   emmc    /dev/block/bootdevice/by-name/fsc                                  flags=display="EFS (FSC)";backup=1;subpartitionof=/fsg
/modemst1              emmc    /dev/block/bootdevice/by-name/modemst1                             flags=display="EFS (ModemST1)";backup=1;subpartitionof=/fsg
/modemst2              emmc    /dev/block/bootdevice/by-name/modemst2                             flags=display="EFS (ModemST2)";backup=1;subpartitionof=/fsg

# Removable storage
/usb_otg               auto    /dev/block/sdg1                               /dev/block/sdg       flags=display="USB-Storage";fsflags="utf8,sync";storage;formattable;removable
/storage       	       auto    /data/media/0                  		                              flags=display="Storage";backup=1;usermrf;fsflags="bind,utf8";removable

# Other partitions
/misc                  emmc    /dev/block/bootdevice/by-name/misc                                 flags=display="Misc";backup=1  